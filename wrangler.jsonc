{
  // Delipastel — custos e preços (Cloudflare Workers).
  // Cada envio para a branch main publica sozinho.
  // site/ = arquivos do app; worker/index.js = serve o site e, a cada 2 dias,
  // mantém o banco Supabase acordado.
  "name": "delipastel",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "triggers": { "crons": ["23 13 */2 * *"] }
}
